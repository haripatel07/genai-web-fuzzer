# Environment variables used by AI-Smart-Fuzzer (optional).  
# CLI args override env vars.

# Target base URL (e.g., http://localhost:8080)
FUZZER_BASE_URL=http://localhost:8080

# Path to fuzz (default: /)
FUZZER_PATH=/search

# Parameter to fuzz (required)
FUZZER_PARAM=q

# Number of payloads to send
FUZZER_NUM_PAYLOADS=100

# HTTP method (GET or POST)
FUZZER_METHOD=GET

# Number of concurrent threads
FUZZER_THREADS=5

# Rate limit in requests per second (0 = no rate limiting)
FUZZER_RATE_LIMIT=10

# Output file for findings
FUZZER_OUTPUT_FILE=output/results.json
